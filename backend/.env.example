DATABASE_URL=jdbc:postgresql://localhost:5432/boothhana
DATABASE_USERNAME=boothhana
DATABASE_PASSWORD=change-me
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
ADMIN_KAKAO_SUBJECTS=
GCS_PROJECT_ID=
GCS_PUBLIC_BUCKET=
GCS_PRIVATE_BUCKET=
GCS_PUBLIC_URL=
# Local: path to a service-account JSON file. Render: /etc/secrets/gcs-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# v2 upload limits (server only)
UPLOAD_MAX_PER_HOUR=20
UPLOAD_MAX_BYTES_PER_DAY=104857600
# v3/v4 collector service token: generate a random value >=32 characters, shared ONLY with worker
BOOTH_COLLECTOR_TOKEN=

# v12 Optional: enable only after private bucket / abuse / retention review.
SUPPORT_GUEST_ENABLED=false
SUPPORT_RATE_SECRET=
SUPPORT_ATTACHMENTS_ENABLED=false

# v14: bound connection acquisition and concurrent private attachment buffers.
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=5000
SUPPORT_ATTACHMENT_CONCURRENCY=4

{
  "functions": {
    "api/page.mjs": {
      "includeFiles": "seo-template/index.html",
      "maxDuration": 10
    },
    "api/sitemap.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "destination": "/api/page?path=/"
    },
    {
      "source": "/:path*",
      "destination": "/api/page?path=/:path*"
    }
  ],
  "buildCommand": "pnpm run build:hosting",
  "headers": [
    {"source":"/library-sw.js","headers":[{"key":"Cache-Control","value":"no-cache"}]},
    {
      "source": "/offline/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/offline/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}

VITE_API_BASE_URL=http://localhost:8080
# The actual production frontend HTTPS origin, not an invented domain.
# Keep both values identical. Missing values intentionally result in noindex/no canonical.
VITE_PUBLIC_SITE_URL=
PUBLIC_SITE_URL=
GOOGLE_SITE_VERIFICATION=
VITE_GOOGLE_SITE_VERIFICATION=
# Enable BOTH only after category subdomains have valid DNS/TLS and API CORS.
# Recognized category hosts always serve their own site; this gate switches legacy URLs.
CATEGORY_SITES_ENABLED=false
VITE_CATEGORY_SITES_ENABLED=false
# Server-only fixed PUBLIC API origin. No secrets or cookies are forwarded.
SEO_API_BASE_URL=http://localhost:8080

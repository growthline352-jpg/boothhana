# Save outside repository at /etc/boothhana/collector.env with mode 600, readable by root.
# The service manager reads this file before switching to service user.
BOOTH_COLLECTOR_TOKEN=replace-with-the-same-long-random-backend-token
# Optional API authentication for Codex. Otherwise use a dedicated CODEX_HOME with a file login.
# CODEX_API_KEY=replace-with-secret

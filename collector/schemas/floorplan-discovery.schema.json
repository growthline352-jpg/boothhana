{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "FOUND",
        "NOT_FOUND",
        "ANNOUNCED",
        "ERROR"
      ]
    },
    "availableOn": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "imageUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "pageUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "scope": {
            "type": "object",
            "properties": {
              "hall": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "zone": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "dates": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "format": "date",
                  "maxLength": 10
                },
                "maxItems": 90,
                "uniqueItems": true
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "hall",
              "zone",
              "dates",
              "title"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "imageUrl",
          "pageUrl",
          "scope",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "checkedUrls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "maxItems": 30
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 50
    }
  },
  "required": [
    "status",
    "availableOn",
    "plans",
    "checkedUrls",
    "warnings"
  ],
  "additionalProperties": false
}

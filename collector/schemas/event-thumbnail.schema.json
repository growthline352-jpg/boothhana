{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventName", "searchStatus", "queries", "sources", "summary"],
  "properties": {
    "eventId": {"type": "integer", "minimum": 1},
    "eventName": {"type": "string", "minLength": 1, "maxLength": 1000},
    "searchStatus": {"enum": ["FOUND", "NO_RESULT", "INACCESSIBLE", "FAILED"]},
    "queries": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "sources": {
      "type": "array", "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["url", "kind", "evidence", "imageUrls"],
        "properties": {
          "url": {"type": "string", "minLength": 1, "maxLength": 2048},
          "kind": {"enum": ["OFFICIAL", "VENUE", "ORGANIZER_SOCIAL"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 1000},
          "imageUrls": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 2048}}
        }
      }
    },
    "summary": {"type": "string", "maxLength": 1000}
  }
}

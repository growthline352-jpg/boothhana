[Unit]
Description=BoothHana imminent floorplan supplemental collection
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/boothhana/deploy/ubuntu
ExecStart=/opt/boothhana/deploy/ubuntu/run-collector.sh floorplans
TimeoutStartSec=12h
SuccessExitStatus=2
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

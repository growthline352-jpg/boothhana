# Public hostname routed to this Ubuntu server. Do not include https://.
API_DOMAIN=api.example.com

# Supabase PostgreSQL JDBC connection
DATABASE_URL=jdbc:postgresql://DB_HOST:5432/DB_NAME?sslmode=require
DATABASE_USERNAME=replace-me
DATABASE_PASSWORD=replace-me
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=5000

# Public frontend and credentialed CORS origins (comma-separated, no trailing slash)
FRONTEND_URL=https://boothhana.vercel.app
ALLOWED_ORIGINS=https://boothhana.vercel.app

# Kakao OAuth
KAKAO_CLIENT_ID=replace-me
KAKAO_CLIENT_SECRET=replace-me

# Separate administrator login. Store only a bcrypt strength-12 hash.
ADMIN_LOGIN_USERNAME=replace-me
ADMIN_LOGIN_PASSWORD_HASH=replace-with-bcrypt-strength-12-hash

# Google Cloud Storage
GCS_PROJECT_ID=boothhana2-production
GCS_PUBLIC_BUCKET=replace-me
GCS_PRIVATE_BUCKET=replace-me
GCS_PUBLIC_URL=https://storage.googleapis.com/replace-me

# Internal collector and support security
BOOTH_COLLECTOR_TOKEN=replace-me
SUPPORT_RATE_SECRET=replace-with-at-least-32-random-bytes
SUPPORT_GUEST_ENABLED=false
SUPPORT_ATTACHMENTS_ENABLED=true

# Cross-site cookie settings for Vercel frontend -> API domain
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=none

# JVM/container limits
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/urandom
